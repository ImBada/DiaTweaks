#!/bin/sh
# Checks which builds are offered the latest DiaTweaks release, and that a Dia download it can't use is remembered,
# without a network or Dia. Run after make.
set -eu
cd "$(dirname "$0")/.."
diapatch=$PWD/build/diapatch
[ -x "$diapatch" ] || { echo "$diapatch is missing: run make first" >&2; exit 1; }
temporary=$(mktemp -d "${TMPDIR:-/tmp}/tweaks-update-test.XXXXXX")
trap 'rm -rf "$temporary"' EXIT
mkdir "$temporary/home" "$temporary/compare"

cat > "$temporary/release.json" <<'JSON'
{"tag_name": "v2.0.0", "html_url": "https://example.test/v2.0.0", "assets": [
  {"name": "DiaTweaks.zip", "size": 1, "digest": "sha256:aaaa", "browser_download_url": "https://example.test/DiaTweaks.zip"}]}
JSON
newer=1111111111111111111111111111111111111111
same=2222222222222222222222222222222222222222
older=3333333333333333333333333333333333333333
forked=4444444444444444444444444444444444444444
unknown=5555555555555555555555555555555555555555
for pair in "$newer ahead" "$same identical" "$older behind" "$forked diverged"; do
    set -- $pair
    printf '{"status": "%s"}\n' "$2" > "$temporary/compare/v2.0.0...$1"
done

# check <name> <expected> [commit]: expected is whether the update check offers v2.0.0.
failures=0
check() {
    available=$(DIAPATCH_HOME="$temporary/home" DIAPATCH_CACHE="$temporary/cache" DIAPATCH_FEED="file://$temporary/none.xml" \
        DIAPATCH_RELEASES="file://$temporary/release.json" DIAPATCH_COMPARE="file://$temporary/compare" \
        DIAPATCH_COMMIT="${3-}" "$diapatch" check --json | plutil -extract tweaks.available raw -o - -)
    if [ "$available" = "$2" ]; then echo "ok   $1"; else echo "FAIL $1: available is $available, expected $2" >&2; failures=$((failures + 1)); fi
}

rm -f "$temporary/home/release.plist"
check "source build past the release" false "$newer"
check "source build at the release" false "$same"
check "source build before the release" true "$older"
check "source build on another branch" true "$forked"
check "source build GitHub doesn't know" true "$unknown"
check "source build with a malformed commit" true "not-a-commit"

printf '<plist><dict><key>digest</key><string>sha256:old</string><key>tag</key><string>v1.0.0</string></dict></plist>' > "$temporary/home/release.plist"
check "release install, newer release" true "$newer"
printf '<plist><dict><key>digest</key><string>sha256:aaaa</string><key>tag</key><string>v2.0.0</string></dict></plist>' > "$temporary/home/release.plist"
mkdir -p "$temporary/home/bin" "$temporary/home/app-icons"
touch "$temporary/home/bin/diapatch" "$temporary/home/bin/diatweaks" "$temporary/home/DiaPatches.dylib" "$temporary/home/patches.json"
check "release install, same release" false "$older"
# An older updater installs only the files it knows about, as v1.1.0 did with app-icons.
rmdir "$temporary/home/app-icons"
check "release install, same release missing a file" true "$older"

rm -f "$temporary/home/release.plist"
message=$(DIAPATCH_HOME="$temporary/home" DIAPATCH_CACHE="$temporary/cache" DIAPATCH_RELEASES="file://$temporary/release.json" \
    DIAPATCH_COMPARE="file://$temporary/compare" DIAPATCH_COMMIT="$newer" "$diapatch" self-update)
case $message in *"older than the source build 1111111 "*) echo "ok   self-update names the reason" ;;
    *) echo "FAIL self-update said: $message" >&2; failures=$((failures + 1)) ;; esac

dia() {
    DIAPATCH_HOME="$temporary/dia-home" DIAPATCH_CACHE="$temporary/dia-cache" DIAPATCH_APP="$temporary/none.app" \
        DIAPATCH_FEED="file://$temporary/dia.xml" DIAPATCH_RELEASES="file://$temporary/release.json" "$diapatch" "$@"
}
offer() {
    printf '<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"><channel><item><enclosure url="file://%s" length="1" sparkle:version="%s"/></item></channel></rss>' \
        "$temporary/Dia.zip" "$1" > "$temporary/dia.xml"
}
# download <build offered> <bundle id> <build inside>: runs `update` on a zip holding a stand-in Dia.
download() {
    mkdir -p "$temporary/zip/Dia.app/Contents"
    printf '<plist><dict><key>CFBundleIdentifier</key><string>%s</string><key>CFBundleVersion</key><string>%s</string></dict></plist>' \
        "$2" "$3" > "$temporary/zip/Dia.app/Contents/Info.plist"
    rm -f "$temporary/Dia.zip" "$temporary/dia-home/unpatchable.plist"
    ditto -c -k --keepParent "$temporary/zip/Dia.app" "$temporary/Dia.zip"
    offer "$1"
    dia update > /dev/null 2>&1 || true
}
reason() { dia check --json | plutil -extract dia.unpatchable raw -o - - 2> /dev/null || true; }
mentions() { reason | grep -qF -- "$1"; }
silent() { [ -z "$(reason)" ]; }
# expect <name> <command...>: passes when the command succeeds.
expect() {
    name=$1; shift
    if "$@"; then echo "ok   $name"; else echo "FAIL $name" >&2; failures=$((failures + 1)); fi
}

download 200 company.thebrowser.dia 199
expect "a download of another build is remembered" mentions "Couldn’t verify this version: the download holds build 199, not 200"
offer 201
expect "a newer build is tried again" silent
download 200 com.example.other 200
expect "a download that isn't Dia is remembered" mentions "is not Dia"
rm -f "$temporary/dia-home/unpatchable.plist"
echo garbage > "$temporary/Dia.zip"
offer 200
dia update > /dev/null 2>&1 || true
expect "a download that doesn't unpack is not remembered" silent

expect "unreachable feed fails update" sh -c "! DIAPATCH_HOME='$temporary/dia-home' DIAPATCH_CACHE='$temporary/dia-cache' DIAPATCH_APP='$temporary/none.app' DIAPATCH_FEED='file://$temporary/missing.xml' '$diapatch' update >/dev/null 2>&1"

printf '{"tag_name":"v2.0.0","assets":"oops"}\n' > "$temporary/bad-assets.json"
expect "non-array assets JSON is rejected cleanly" sh -c "DIAPATCH_HOME='$temporary/home' DIAPATCH_CACHE='$temporary/cache' DIAPATCH_FEED='file://$temporary/none.xml' DIAPATCH_RELEASES='file://$temporary/bad-assets.json' '$diapatch' check --json >/dev/null"

printf '{"tag_name":"v2.0.0","assets":[{"name":"DiaTweaks.zip","digest":"sha256:aaaa"}]}\n' > "$temporary/missing-url.json"
expect "missing browser_download_url is rejected cleanly" sh -c "DIAPATCH_HOME='$temporary/home' DIAPATCH_CACHE='$temporary/cache' DIAPATCH_FEED='file://$temporary/none.xml' DIAPATCH_RELEASES='file://$temporary/missing-url.json' '$diapatch' check --json >/dev/null"

printf '\xff\xfe\xfd' > "$temporary/nonutf8.bin"
expect "non-UTF8 feed and release responses do not crash" sh -c "DIAPATCH_HOME='$temporary/home' DIAPATCH_CACHE='$temporary/cache' DIAPATCH_FEED='file://$temporary/nonutf8.bin' DIAPATCH_RELEASES='file://$temporary/nonutf8.bin' '$diapatch' check --json >/dev/null"

start=$(date +%s)
DIAPATCH_HOME="$temporary/relaunch-home" DIAPATCH_CACHE="$temporary/relaunch-cache" DIAPATCH_APP="$temporary/missing.app" "$diapatch" install --relaunch >/dev/null 2>&1 || true
elapsed=$(( $(date +%s) - start ))
expect "install --relaunch on missing app exits promptly" test "$elapsed" -lt 4

[ "$failures" = 0 ]
