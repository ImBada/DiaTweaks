#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
manifest=build/patches.json
[ -f "$manifest" ] || { echo "$manifest is missing: run make first" >&2; exit 1; }
symbols=$(plutil -extract patches json -o - "$manifest" | python3 -c '
import json, sys
for p in json.load(sys.stdin): print(p["symbol"] or "")
'; grep -rhoE 'imageWithSystemSymbolName:@"[^"]+"|DPCommandItem\([^;]*, @"[a-z0-9.]+", \^' src/dylib | grep -oE '@"[a-z0-9. ]+"' | tr -d '@"')
missing=$(printf '%s\n' "$symbols" | sort -u | osascript -l JavaScript -e '
ObjC.import("AppKit")
function run(argv) {
    const lines = $.NSString.alloc.initWithDataEncoding($.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile, 4).js.split("\n")
    return lines.filter(line => line && !line.split(" ").some(name => $.NSImage.imageWithSystemSymbolNameAccessibilityDescription(name, $()).isNil() === false)).join("\n")
}')
python3 - "$manifest" "$missing" <<'PY'
import glob, json, re, sys
patches = {p["key"]: p for p in json.load(open(sys.argv[1]))["patches"]}
problems = [f'no SF Symbol called "{name}"' for name in sys.argv[2].split("\n") if name]

# The folder rows live in Settings, so read their keys and sections from there.
settings = open("src/dylib/Settings/Folder.m").read().split("DPFolders[] = {", 1)[1].split("\n};", 1)[0]
folders = {key: section for key, _, _, _, _, section in re.findall(
    r'\{\s*@"([^"]+)",\s*@"([^"]+)",\s*@"([^"]*)",\s*@"([^"]+)",\s*@"([^"]+)",\s*@"([^"]+)"\s*\}', settings, re.S)}
for key, patch in patches.items():
    if not patch.get("group"):
        continue
    if patch["requires"]:
        problems.append(f'{key} is in the {patch["group"]} folder, so it can\'t need another tweak')
    elif patch["group"] not in folders:
        problems.append(f'{key} is in a folder called {patch["group"]}, which Settings doesn\'t have')
    elif patch["section"] != folders[patch["group"]]:
        problems.append(f'{key} is in {patch["section"]}, but its {patch["group"]} folder is in {folders[patch["group"]]}')
for key in folders:
    if not any(patch.get("group") == key for patch in patches.values()):
        problems.append(f'the {key} folder has no tweaks in it')

def root(patch):
    seen = set()
    while patch["requires"]:
        if patch["key"] in seen:
            break
        seen.add(patch["key"])
        patch = patches[patch["requires"]]
    return patch

tints = {}
for patch in patches.values():
    if not patch["requires"]:
        tints.setdefault(patch["section"], {}).setdefault(patch["tint"], []).append(patch["key"])
    elif patch["tint"] != root(patch)["tint"]:
        problems.append(f'{patch["key"]} is {patch["tint"]}, but its tweak {root(patch)["key"]} is {root(patch)["tint"]}')
    if len(patch["detail"]) > 280:
        problems.append(f'{patch["key"]}\'s description is {len(patch["detail"])} characters: keep it under 280 and put the rest on its wiki page')
for section, by_tint in tints.items():
    if len(by_tint) > 1:
        problems.append(f'{section} mixes colors: ' + "; ".join(f'{tint} for {", ".join(keys)}' for tint, keys in by_tint.items()))

for key, patch in patches.items():
    for field in ("title", "detail", "section"):
        value = patch.get(field)
        if isinstance(value, str) and "'" in value:
            problems.append(f'{key}\'s {field} uses a straight apostrophe: {value}')
for path in sorted(glob.glob("src/dylib/**/*.m", recursive=True)):
    for number, line in enumerate(open(path), 1):
        if re.search(r'\.(?:section|hint)\s*=\s*@"[^"]*\'', line):
            problems.append(f'{path}:{number} uses a straight apostrophe in a user-visible string')

bug = open(".github/ISSUE_TEMPLATE/bug.yml").read().split("id: patch", 1)[1].split("- type:", 1)[0]
listed = set(re.findall(r'^\s+- (.+)$', bug, re.M))
sentinels = {"Patches pane in Settings", "Installing, updating or restoring", "Not sure"}
titles = {patch["title"] for patch in patches.values()}
for title in sorted(titles - listed):
    problems.append(f'bug.yml has no option for "{title}"')
for option in sorted(listed - titles - sentinels):
    problems.append(f'bug.yml lists "{option}", which is not a tweak')

for problem in problems:
    print(problem, file=sys.stderr)
if not problems:
    print(f"all {len(patches)} tweaks match their sections")
sys.exit(1 if problems else 0)
PY
